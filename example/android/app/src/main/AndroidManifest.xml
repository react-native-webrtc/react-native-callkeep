<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- react-native-callkeep. The library's own manifest adds CALL_PHONE, READ_PHONE_NUMBERS,
         MANAGE_OWN_CALLS and READ_PHONE_STATE (up to Android 10). -->
    <!-- The microphone for the call, and the foreground service that keeps it while the app is in
         the background. The library starts that service with every type declared on it below. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+: the foreground service's notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- The ConnectionService Telecom talks to. BIND_TELECOM_CONNECTION_SERVICE protects it:
           only the system can bind to it, so the app doesn't request that permission itself. -->
      <service
        android:name="io.wazo.callkeep.VoiceConnectionService"
        android:label="CallKeep Example"
        android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
        android:foregroundServiceType="phoneCall|microphone"
        android:exported="true">
        <intent-filter>
          <action android:name="android.telecom.ConnectionService" />
        </intent-filter>
      </service>

      <!-- Wakes the app when a call is started from the Phone app while it isn't running (managed mode). -->
      <service android:name="io.wazo.callkeep.RNCallKeepBackgroundMessagingService" />
    </application>
</manifest>
